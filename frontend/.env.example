# FlyConnect Tech frontend settings.
# Copy this file to ".env.local" and change the values if you need to.
# ".env.local" stays on your computer and is never saved to git.
#
# Names that start with NEXT_PUBLIC_ are visible in the browser.
# Never put a password or secret key in this file.

# The address of this website.
# On your PC: http://localhost:3001   Online: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# The address of the backend (the NestJS app in the "backend" folder).
# On your PC: http://localhost:4000   Online: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:4000
