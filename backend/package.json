{
  "name": "flyconnect-tech-backend",
  "version": "0.0.1",
  "description": "FlyConnect Tech backend (NestJS + Prisma + MariaDB)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src/ test/",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./jest.config.e2e.mjs",
    "test:db": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./jest.config.db.mjs --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "node -e \"require('fs').existsSync('prisma/schema.prisma') ? require('child_process').execSync('prisma generate', { stdio: 'inherit' }) : console.log('prisma generate skipped: no prisma/schema.prisma in this folder (the live server uses the client built into dist)')\"",
    "auth:schema": "auth generate --config src/auth/auth.schema.ts --adapter prisma --dialect mysql --output prisma/auth-schema.generated.prisma --yes",
    "preuser:invite": "tsc -p tsconfig.build.json",
    "user:invite": "node dist/cli/invite-user.js",
    "preproject:add": "tsc -p tsconfig.build.json",
    "project:add": "node dist/cli/add-project.js",
    "prejob": "tsc -p tsconfig.build.json",
    "job": "node dist/cli/run-job.js",
    "e2e:serve": "node scripts/prepare-database.mjs && tsc -p tsconfig.build.json && node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.2",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "better-auth": "^1.7.24",
    "dotenv": "^18.0.10",
    "nodemailer": "^10.5.0",
    "prisma": "7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.0.0",
    "auth": "1.7.24",
    "jest": "^30.5.2",
    "mariadb": "3.5.4",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2"
  }
}
