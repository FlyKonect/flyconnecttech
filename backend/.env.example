# FlyConnect Tech backend settings.
# Copy this file to ".env" and change the values if you need to.
# ".env" stays on your computer (or the server) and is never saved to git.
# Never paste real passwords or keys into the chat, the docs or this example file.

# "development" on your PC, "production" on the live hosting.
NODE_ENV=development

# The port the backend listens on. On cPanel the hosting sets this itself.
PORT=4000

# The address of the website (the "frontend" folder). Only this address is
# allowed to call the backend from a browser.
# On your PC: http://localhost:3001   Online: https://yourdomain.com
FRONTEND_URL=http://localhost:3001

# The MariaDB database: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# On your PC this is the Docker database (see docker-compose.yml).
# Online, use the database, user and password you create in cPanel.
DATABASE_URL=mysql://root:root@localhost:3306/flyconnect_tech

# Email server. On your PC this is Mailpit: emails are not really sent, you
# read them at http://localhost:8025. Online, use the hosting's email settings.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# The sender shown on every email. Placeholder until the client gives the real address.
EMAIL_FROM="FlyConnect Tech <hello@yourdomain.com>"

# Folder where uploaded files (request attachments) are saved.
# Online it must sit outside the public web folder.
UPLOAD_DIR=./uploads

# --- Added in later phases (leave out for now) ---
# AUTH_SECRET=        # Phase 4: a long random text that protects sign-in sessions
# RESEND_API_KEY=     # Phase 9: only if emails are sent through Resend
